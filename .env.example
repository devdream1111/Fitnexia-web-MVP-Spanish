# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it is listed in `.gitignore`.

# API base URL (production/staging — stable host, not ngrok)
NEXT_PUBLIC_API_URL=https://your-api-host/fitnexia-api/v1

# App URL used for OAuth redirects and absolute links (local dev or deployed web origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Native mobile app store listings (footer / hero / auth download badges).
# Leave empty to show "Próximamente".
NEXT_PUBLIC_IOS_APP_STORE_URL=
NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=

# Android APK direct download (used when Play Store URL is empty).
# Paste a Drive share link (Anyone with the link). The app proxies it via
# /api/downloads/android-apk so the browser saves fitnexia.apk same-origin.
# Example: https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=sharing
NEXT_PUBLIC_ANDROID_APK_URL=

# Google OAuth — Web application client (Google Cloud Console)
# Client ID is safe to expose in the browser; secret must stay server-side only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
